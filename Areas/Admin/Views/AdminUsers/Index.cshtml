@model IEnumerable<Nights.Models.ViewModels.UserPermissionViewModel>
@{
    ViewData["Title"] = "Kullanıcı İzinleri & Not Defteri Yetkisi";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 style="font-size: 1.85rem; color: var(--accent-sapphire);">Kullanıcı İzinleri &amp; Not Defteri Erişimi</h1>
        <p style="color: var(--text-muted); font-size: 0.95rem;">
            Kayıt olan kullanıcılardan hangilerinin özel not alanını görebileceğini ve not ekleyebileceğini buradan yönetebilirsiniz.
        </p>
    </div>
</div>

<div class="ottoman-frame" style="padding: 1.75rem; overflow-x: auto;">
    <span class="ottoman-corner corner-tl"></span>
    <span class="ottoman-corner corner-tr"></span>
    <span class="ottoman-corner corner-bl"></span>
    <span class="ottoman-corner corner-br"></span>

    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
        <thead>
            <tr style="background: var(--bg-parchment); border-bottom: 1px solid var(--border-cetvel); color: var(--accent-sapphire);">
                <th style="padding: 1rem 1.25rem;">Kullanıcı Adı / E-posta</th>
                <th style="padding: 1rem 1.25rem;">Rol</th>
                <th style="padding: 1rem 1.25rem;">Not Defteri Erişimi</th>
                <th style="padding: 1rem 1.25rem; text-align: right;">Yetki Değiştir</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr id="user-row-@user.UserId" style="border-bottom: 1px solid var(--border-light);">
                    <td style="padding: 1rem 1.25rem;">
                        <strong>@user.UserName</strong>
                        <div style="font-size: 0.82rem; color: var(--text-muted);">@user.Email</div>
                    </td>
                    <td style="padding: 1rem 1.25rem;">
                        @if (user.IsAdmin)
                        {
                            <span class="badge-ottoman" style="background: var(--accent-sapphire); color: #fff;">Yönetici (Admin)</span>
                        }
                        else
                        {
                            <span style="color: var(--text-muted); font-size: 0.88rem;">Standart Kullanıcı</span>
                        }
                    </td>
                    <td style="padding: 1rem 1.25rem;" id="access-badge-@user.UserId">
                        @if (user.HasNoteAccess)
                        {
                            <span style="color: #137333; font-weight: 600; font-size: 0.9rem;">✓ İzin Verildi (280 Kelime)</span>
                        }
                        else
                        {
                            <span style="color: var(--danger-rose); font-weight: 500; font-size: 0.9rem;">✕ Erişim Yok</span>
                        }
                    </td>
                    <td style="padding: 1rem 1.25rem; text-align: right;">
                        @if (user.IsAdmin)
                        {
                            <span style="color: var(--text-muted); font-size: 0.85rem;">Değiştirilemez</span>
                        }
                        else
                        {
                            <button type="button" class="btn-ottoman-outline" data-toggle-note-access data-id="@user.UserId"
                                    style="min-height: 36px; padding: 0.35rem 0.9rem; font-size: 0.85rem;">
                                @(user.HasNoteAccess ? "Yetkiyi Kaldır" : "Yetki Ver")
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
