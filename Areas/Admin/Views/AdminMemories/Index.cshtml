@model IEnumerable<Nights.Models.Entities.Memory>
@{
    ViewData["Title"] = "Onay Bekleyen Anılar";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div>
        <h1 style="font-family: var(--font-serif); font-size: 2.2rem; color: var(--text-white); margin-bottom: 0.35rem;">
            ✦ Onay Bekleyen Ziyaretçi Anıları
        </h1>
        <p style="color: var(--text-muted); font-size: 0.95rem;">
            Ziyaretçiler tarafından yüklenen görseller izole <code>uploads/pending/</code> dizinindedir. Onaylananlar <code>approved/</code> dizinine taşınır ve cache tazelenir.
        </p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="divan-corner-box ottoman-frame" style="padding: 3.5rem; text-align: center;">
        <span class="divan-corner c-tl"></span>
        <span class="divan-corner c-tr"></span>
        <span class="divan-corner c-bl"></span>
        <span class="divan-corner c-br"></span>
        <span style="font-size: 2.5rem; color: var(--gold-primary); display: block; margin-bottom: 0.5rem;">۞</span>
        <h3 style="color: var(--text-white); font-family: var(--font-serif); font-size: 1.5rem; margin-bottom: 0.5rem;">Bekleyen Anı Yok</h3>
        <p style="color: var(--text-muted);">Tüm ziyaretçi anıları incelenmiş ve onaylanmış durumda.</p>
    </div>
}
else
{
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
        @foreach (var memory in Model)
        {
            <div class="divan-corner-box" id="pending-card-@memory.Id" style="padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between;">
                <span class="divan-corner c-tl"></span>
                <span class="divan-corner c-tr"></span>
                <span class="divan-corner c-bl"></span>
                <span class="divan-corner c-br"></span>

                <div>
                    <div style="width: 100%; height: 220px; overflow: hidden; border-radius: var(--radius-sm); border: 1px solid var(--gold-border); margin-bottom: 1rem;">
                        <img src="@Url.Action("PreviewPendingImage", "AdminMemories", new { f = memory.ImageFileName, area = "Admin" })" 
                             alt="Onay Bekleyen Anı" style="width: 100%; height: 100%; object-fit: cover;" />
                    </div>
                    <p style="font-size: 0.95rem; color: var(--text-white); line-height: 1.5; margin-bottom: 0.75rem;">@memory.Description</p>
                    <div style="font-size: 0.8rem; color: var(--gold-primary); margin-bottom: 1rem;">
                        <span>IP Özeti: @(memory.SubmitterIpHash.Length > 8 ? memory.SubmitterIpHash[..8] : memory.SubmitterIpHash)...</span> &bull; 
                        <time>@memory.CreatedAt.ToString("g")</time>
                    </div>
                </div>

                <div style="display: flex; gap: 0.75rem; border-top: 1px solid rgba(197, 160, 89, 0.2); padding-top: 1rem;">
                    <button type="button" class="btn-divan-primary" data-admin-action="approve" data-id="@memory.Id" style="flex: 1; justify-content: center; padding: 0.55rem;">
                        ✓ Onayla
                    </button>
                    <button type="button" class="btn-ottoman-outline" data-admin-action="reject" data-id="@memory.Id" style="flex: 1; justify-content: center; padding: 0.55rem; border-color: var(--danger-rose); color: var(--danger-rose) !important;">
                        ✕ Reddet &amp; Sil
                    </button>
                </div>
            </div>
        }
    </div>
}
