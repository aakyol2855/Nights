@model Nights.Models.ViewModels.ProjectEditViewModel
@{
    ViewData["Title"] = "Projeyi ve Rehberleri Düzenle";
    var tutorials = ViewBag.Tutorials as List<Nights.Models.Entities.ProjectTutorial> ?? new();
}

<div style="max-width: 950px; margin: 0 auto;">
    <div style="margin-bottom: 1.5rem;">
        <a asp-area="Admin" asp-action="Index" style="font-size: 0.92rem; color: var(--gold-bright); font-weight: 500;">&larr; Projelere Dön</a>
        <h1 style="font-family: var(--font-serif); font-size: 2rem; color: var(--text-white); margin-top: 0.3rem;">Projeyi Düzenle: @Model.Title</h1>
    </div>

    <!-- Proje Temel Bilgileri Formu -->
    <div class="divan-corner-box ottoman-frame" style="padding: 2.25rem; margin-bottom: 2.5rem;">
        <span class="divan-corner c-tl"></span>
        <span class="divan-corner c-tr"></span>
        <span class="divan-corner c-bl"></span>
        <span class="divan-corner c-br"></span>

        <h2 style="font-size: 1.35rem; color: var(--gold-bright); margin-bottom: 1.25rem;">✦ Temel Bilgiler &amp; Docker Container Yapılandırması</h2>
        <form asp-area="Admin" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 1.25rem;">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" style="color: var(--danger-rose); font-size: 0.9rem;"></div>

            <div class="divan-form-row-2">
                <div class="form-group">
                    <label asp-for="Title" class="form-label">Proje Başlığı</label>
                    <input asp-for="Title" class="form-control" required />
                </div>
                <div class="form-group">
                    <label asp-for="Slug" class="form-label">URL Slug (/live-demo/slug/)</label>
                    <input asp-for="Slug" class="form-control" placeholder="Örn: ditib-yonetim" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Summary" class="form-label">Kısa Özet</label>
                <textarea asp-for="Summary" class="form-control" rows="2" required></textarea>
            </div>

            <div class="divan-form-row-2">
                <div class="form-group">
                    <label asp-for="LiveDemoUrl" class="form-label">Harici Canlı Demo URL (Opsiyonel)</label>
                    <input asp-for="LiveDemoUrl" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="GitHubUrl" class="form-label">GitHub URL</label>
                    <input asp-for="GitHubUrl" class="form-control" />
                </div>
            </div>

            <div class="divan-form-row-2">
                <div class="form-group">
                    <label asp-for="BadgeText" class="form-label">Rozet Metni</label>
                    <input asp-for="BadgeText" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="TechStack" class="form-label">Teknoloji Yığını</label>
                    <input asp-for="TechStack" class="form-control" />
                </div>
            </div>

            <!-- Docker On-Demand Canlı Demo Yapılandırması -->
            <div style="margin-top: 0.5rem; padding: 1.5rem; background: var(--bg-surface); border: 1px solid var(--gold-border); border-radius: var(--radius-sm); display: flex; flex-direction: column; gap: 1rem;">
                <h3 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--gold-bright); margin: 0;">
                    🐳 Docker On-Demand Canlı Demo &amp; Container Yükleme
                </h3>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">
                    Container'lar <code>--memory=256m --cpus=0.40 --read-only</code> sınırlarıyla başlatılır, YARP üzerinden <code>/live-demo/@(string.IsNullOrWhiteSpace(Model.Slug) ? "slug" : Model.Slug)/</code> adresinde sunulur ve 15 dk hareketsizlikte otomatik silinir.
                </p>

                <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 600;">
                        <input asp-for="IsDemoEnabled" type="checkbox" style="width: 18px; height: 18px; accent-color: var(--gold-primary);" />
                        <span>On-Demand Docker Demosunu Aktifleştir</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 600;">
                        <input asp-for="UseSharedDemoNetwork" type="checkbox" style="width: 18px; height: 18px; accent-color: var(--gold-primary);" />
                        <span>Ortak İzole Ağa Bağla (divan_demo_net)</span>
                    </label>
                </div>

                <div class="divan-form-row-2">
                    <div class="form-group">
                        <label asp-for="DockerImageName" class="form-label">Docker İmaj Adı</label>
                        <input asp-for="DockerImageName" class="form-control" placeholder="Örn: ditib-demo:latest" />
                        <span style="font-size: 0.78rem; color: var(--text-muted);">.tar yüklerseniz imaj adı otomatik doldurulur.</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ContainerInternalPort" class="form-label">Container İçi Port</label>
                        <input asp-for="ContainerInternalPort" type="number" class="form-control" min="1" max="65535" />
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="DockerImageTarFile" class="form-label">Yeni Container İmaj Arşivi Yükle (.tar - Max 500MB)</label>
                    <input asp-for="DockerImageTarFile" type="file" class="form-control" accept=".tar" />
                    <span style="font-size: 0.78rem; color: var(--text-muted);">
                        <code>docker save -o proje.tar proje-imaji:latest</code> ile alınan arşiv sunucuda otomatik <code>docker load -i</code> ile kaydedilir ve geçici dosya silinir.
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="EnvironmentVariables" class="form-label">Ortam Değişkenleri (Her satıra bir KEY=VALUE)</label>
                    <textarea asp-for="EnvironmentVariables" class="form-control" rows="4" style="font-family: monospace; font-size: 0.85rem;"
                              placeholder="ASPNETCORE_ENVIRONMENT=Demo&#10;ConnectionStrings__DefaultConnection=Server=nights-mssql;Database=DemoDb;..."></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="MarkdownGuide" class="form-label">Genel Kullanım Rehberi / Test Kılavuzu (Markdown)</label>
                    <textarea asp-for="MarkdownGuide" class="form-control" rows="5"
                              placeholder="### Test Bilgileri&#10;- **Kullanıcı:** `demo@example.com`&#10;- **Şifre:** `Demo123!`"></textarea>
                </div>
            </div>

            <div class="divan-form-row-3">
                <div class="form-group">
                    <label asp-for="DisplayOrder" class="form-label">Sıralama Önceliği</label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" />
                </div>
                <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem; padding-top: 1.5rem;">
                    <input asp-for="IsActive" type="checkbox" style="width: 18px; height: 18px; accent-color: var(--gold-primary);" />
                    <label asp-for="IsActive" style="font-weight: 600; margin-bottom: 0;">Aktif</label>
                </div>
                <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem; padding-top: 1.5rem;">
                    <input asp-for="IsFeatured" type="checkbox" style="width: 18px; height: 18px; accent-color: var(--gold-primary);" />
                    <label asp-for="IsFeatured" style="font-weight: 600; margin-bottom: 0;">Öne Çıkan</label>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 0.5rem;">
                <button type="submit" class="btn-divan-primary">Değişiklikleri Kaydet</button>
            </div>
        </form>
    </div>

    <!-- Rehber / Test Senaryosu Yönetimi -->
    <div class="divan-corner-box ottoman-frame" style="padding: 2.25rem;">
        <span class="divan-corner c-tl"></span>
        <span class="divan-corner c-tr"></span>
        <span class="divan-corner c-bl"></span>
        <span class="divan-corner c-br"></span>

        <h2 style="font-size: 1.35rem; color: var(--gold-bright); margin-bottom: 0.5rem;">
            ✦ Öğretici &amp; Test Rehberi Adımları (Markdown)
        </h2>
        <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 1.5rem;">
            Bu adımlar ziyaretçinin canlı demo alanını nasıl test edeceğini adım adım gösterir.
        </p>

        <!-- Mevcut Adımlar Listesi -->
        @if (tutorials.Any())
        {
            <div style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: 1rem;">
                @foreach (var step in tutorials)
                {
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; padding: 1.1rem; background: var(--bg-surface); border-radius: var(--radius-sm); border: 1px solid var(--gold-border);">
                        <div style="flex: 1; min-width: 220px;">
                            <span class="badge-ottoman" style="margin-bottom: 0.35rem;">✦ Adım #@step.StepOrder</span>
                            <h4 style="color: var(--text-white); margin: 0.4rem 0;">@step.StepTitle</h4>
                            <div style="font-size: 0.88rem; color: var(--text-muted); font-family: monospace; white-space: pre-wrap; max-height: 100px; overflow: hidden;">@step.ContentMarkdown</div>
                        </div>

                        <form asp-area="Admin" asp-action="DeleteTutorial" method="post">
                            <input type="hidden" name="tutorialId" value="@step.Id" />
                            <input type="hidden" name="projectId" value="@Model.Id" />
                            <button type="submit" class="btn-danger-soft" onclick="return confirm('Bu adımı silmek istiyor musunuz?')">
                                Adımı Sil
                            </button>
                        </form>
                    </div>
                }
            </div>
        }

        <!-- Yeni Adım Ekle Formu -->
        <div style="background: var(--bg-surface); padding: 1.5rem; border-radius: var(--radius-sm); border: 1px dashed var(--gold-border);">
            <h3 style="font-size: 1.15rem; color: var(--gold-bright); margin-bottom: 1rem;">+ Yeni Rehber Adımı Ekle</h3>
            <form asp-area="Admin" asp-action="AddTutorial" method="post" style="display: flex; flex-direction: column; gap: 1rem;">
                <input type="hidden" name="ProjectId" value="@Model.Id" />

                <div class="divan-form-row-2">
                    <div>
                        <label class="form-label">Adım Başlığı</label>
                        <input type="text" name="StepTitle" class="form-control" required placeholder="Örn: 1. Test Kullanıcısı ile Giriş" />
                    </div>
                    <div>
                        <label class="form-label">Sıra</label>
                        <input type="number" name="StepOrder" class="form-control" value="@(tutorials.Count + 1)" required />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">İçerik (Markdown Destekli)</label>
                    <textarea name="ContentMarkdown" class="form-control" rows="5" required 
                              placeholder="Kullanıcıya adımları anlatın:&#10;&#10;- **Kullanıcı:** `test@example.com`&#10;- Sağ üstten `Yeni Kayıt` butonuna basın..."></textarea>
                </div>

                <div>
                    <button type="submit" class="btn-divan-primary">Rehber Adımını Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
