@model Nights.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Kontrol Paneli";
}

<div style="margin-bottom: 2rem;">
    <h1 style="font-family: var(--font-serif); font-size: 2.2rem; color: var(--text-white); margin-bottom: 0.35rem;">
        ✦ Yönetim Paneli Özeti
    </h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">Sistem istatistikleri ve onay bekleyen ziyaretçi katkıları</p>
</div>

<!-- İstatistik Kartları -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
    <div class="divan-corner-box ottoman-frame" style="padding: 1.75rem;">
        <span class="divan-corner c-tl"></span>
        <span class="divan-corner c-tr"></span>
        <span style="font-size: 0.8rem; color: var(--gold-bright); font-weight: 600; letter-spacing: 1px;">ONAY BEKLEYEN ANILAR</span>
        <div style="font-size: 2.5rem; font-weight: 700; color: var(--text-white); margin: 0.35rem 0;">
            @Model.PendingMemoriesCount
        </div>
        <a asp-area="Admin" asp-controller="AdminMemories" asp-action="Index" style="font-size: 0.88rem; color: var(--gold-bright); font-weight: 600;">
            İncele ve Onayla &rarr;
        </a>
    </div>

    <div class="divan-corner-box ottoman-frame" style="padding: 1.75rem;">
        <span class="divan-corner c-tl"></span>
        <span class="divan-corner c-tr"></span>
        <span style="font-size: 0.8rem; color: var(--gold-bright); font-weight: 600; letter-spacing: 1px;">YAYINDAKİ ANILAR</span>
        <div style="font-size: 2.5rem; font-weight: 700; color: var(--text-white); margin: 0.35rem 0;">
            @Model.ApprovedMemoriesCount
        </div>
        <span style="font-size: 0.85rem; color: var(--text-muted);">
            Cache ile sunuluyor
        </span>
    </div>

    <div class="divan-corner-box ottoman-frame" style="padding: 1.75rem;">
        <span class="divan-corner c-tl"></span>
        <span class="divan-corner c-tr"></span>
        <span style="font-size: 0.8rem; color: var(--gold-bright); font-weight: 600; letter-spacing: 1px;">TOPLAM PROJE</span>
        <div style="font-size: 2.5rem; font-weight: 700; color: var(--text-white); margin: 0.35rem 0;">
            @Model.ProjectsCount
        </div>
        <a asp-area="Admin" asp-controller="AdminProjects" asp-action="Index" style="font-size: 0.88rem; color: var(--gold-bright); font-weight: 600;">
            Projeleri Yönet &rarr;
        </a>
    </div>
</div>

<!-- Onay Bekleyen Son Anılar -->
<div class="divan-corner-box ottoman-frame" style="padding: 2.25rem;">
    <span class="divan-corner c-tl"></span>
    <span class="divan-corner c-tr"></span>
    <span class="divan-corner c-bl"></span>
    <span class="divan-corner c-br"></span>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--gold-border); padding-bottom: 0.85rem;">
        <h2 style="font-family: var(--font-serif); font-size: 1.5rem; color: var(--text-white);">Onay Bekleyen Son Anılar</h2>
        <a asp-area="Admin" asp-controller="AdminMemories" asp-action="Index" class="btn-ottoman-outline" style="font-size: 0.85rem; padding: 0.35rem 0.9rem;">
            Tüm Onay Bekleyenler &rarr;
        </a>
    </div>

    @if (!Model.RecentPendingMemories.Any())
    {
        <p style="color: var(--text-muted); font-size: 0.95rem;">Şu an onay bekleyen herhangi bir anı bulunmuyor.</p>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            @foreach (var memory in Model.RecentPendingMemories)
            {
                <div id="pending-card-@memory.Id" style="display: flex; align-items: center; gap: 1.25rem; padding: 1.15rem; background: var(--bg-surface); border-radius: var(--radius-sm); border: 1px solid var(--gold-border); flex-wrap: wrap;">
                    <img src="@Url.Action("PreviewPendingImage", "AdminMemories", new { f = memory.ImageFileName, area = "Admin" })" 
                         alt="Önizleme" style="width: 80px; height: 60px; object-fit: cover; border-radius: var(--radius-sm); border: 1px solid var(--gold-border);" />
                    
                    <div style="flex: 1; min-width: 200px;">
                        <p style="font-size: 0.95rem; font-weight: 500; color: var(--text-white);">@memory.Description</p>
                        <span style="font-size: 0.8rem; color: var(--gold-primary);">Gönderilme: @memory.CreatedAt.ToString("g")</span>
                    </div>

                    <div style="display: flex; gap: 0.5rem;">
                        <button type="button" class="btn-divan-primary" data-admin-action="approve" data-id="@memory.Id" style="padding: 0.45rem 1rem; font-size: 0.85rem;">
                            Onayla
                        </button>
                        <button type="button" class="btn-ottoman-outline" data-admin-action="reject" data-id="@memory.Id" style="padding: 0.45rem 1rem; font-size: 0.85rem; border-color: var(--danger-rose); color: var(--danger-rose) !important;">
                            Reddet
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>
