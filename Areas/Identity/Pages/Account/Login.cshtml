@page
@model Nights.Areas.Identity.Pages.Account.LoginModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Dergâha Giriş";
    var turnstileSiteKey = Configuration["CloudflareTurnstile:SiteKey"] ?? "1x00000000000000000000AA";
}

<div class="divan-auth-wrapper">
    <div class="divan-auth-card divan-corner-box ottoman-frame">
        <span class="divan-corner c-tl"></span>
        <span class="divan-corner c-tr"></span>
        <span class="divan-corner c-bl"></span>
        <span class="divan-corner c-br"></span>

        <!-- Üst Tuğra & Başlık -->
        <div class="divan-auth-header">
            <div class="divan-auth-crest">
                <img src="~/images/tugra.svg" alt="Tuğra" class="divan-auth-tugra" />
            </div>
            <span class="badge-ottoman" style="margin-bottom: 0.75rem;">
                <span>۞</span> BÂB-I DÜHÛL &bull; KİMLİK DOĞRULAMA <span>۞</span>
            </span>
            <h1 class="divan-auth-title">Divan'a Giriş</h1>
            <p class="divan-auth-subtitle">
                Özel arşiv, varaklar ve yönetim kalemine erişmek için kimliğinizi doğrulayın.
            </p>
        </div>

        <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl" class="divan-auth-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="divan-auth-alert" role="alert"></div>

            <!-- Honeypot (Bot Tuzağı - Görünmez Alan) -->
            <div style="position: absolute; left: -9999px; opacity: 0; height: 0; overflow: hidden;" aria-hidden="true">
                <label asp-for="Input.WebsiteUrl">Website</label>
                <input asp-for="Input.WebsiteUrl" tabindex="-1" autocomplete="off" />
            </div>

            <!-- E-posta / Kullanıcı Adı -->
            <div class="divan-form-group">
                <label asp-for="Input.Email" class="form-label">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px;">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    E-Posta Adresi veya Kullanıcı Adı
                </label>
                <input asp-for="Input.Email" class="form-control divan-auth-input" autocomplete="username" aria-required="true" placeholder="ornek@alanadi.com" required />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Parola -->
            <div class="divan-form-group">
                <label asp-for="Input.Password" class="form-label">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px;">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    Parola
                </label>
                <div class="divan-password-box">
                    <input asp-for="Input.Password" id="loginPasswordInput" class="form-control divan-auth-input" autocomplete="current-password" aria-required="true" placeholder="••••••••" required />
                    <button type="button" class="divan-password-toggle" data-toggle-password="loginPasswordInput" aria-label="Parolayı Göster/Gizle" title="Parolayı Göster/Gizle">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Beni Hatırla & Güvenlik Rozeti -->
            <div class="divan-auth-options">
                <label asp-for="Input.RememberMe" class="divan-checkbox-label">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <span>@Html.DisplayNameFor(m => m.Input.RememberMe)</span>
                </label>
                <span class="divan-security-pill" title="256-Bit Şifreli Oturum & Brute-Force Koruması">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    Korumalı Oturum
                </span>
            </div>

            <!-- Cloudflare Turnstile CAPTCHA -->
            <div class="divan-turnstile-box">
                <div class="cf-turnstile" data-sitekey="@turnstileSiteKey" data-theme="dark"></div>
            </div>

            <!-- Giriş Butonu -->
            <button id="login-submit" type="submit" class="btn-divan-primary divan-auth-submit">
                <span>✦ DERGÂHA GİRİŞ YAP</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </form>

        <div class="ottoman-divider" style="margin: 1.75rem 0 1.25rem;">
            <div class="ottoman-divider-crest">
                <span>✦</span> ۞ <span>✦</span>
            </div>
        </div>

        <!-- Alt Bağlantılar -->
        <div class="divan-auth-footer">
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.75rem;">
                Henüz bir hesabınız yok mu?
            </p>
            <div class="divan-auth-actions">
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn-ottoman-outline" style="width: 100%; justify-content: center;">
                    <span>Yeni Hesap Oluştur &rarr;</span>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
}
