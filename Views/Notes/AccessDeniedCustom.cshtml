@{
    ViewData["Title"] = L["Notes_AccessDeniedTitle"];
}

<div style="max-width: 650px; margin: 4rem auto;">
    <div class="divan-corner-box ottoman-frame" style="text-align: center; padding: 3.5rem 2.5rem;">
        <span class="divan-corner c-tl"></span>
        <span class="divan-corner c-tr"></span>
        <span class="divan-corner c-bl"></span>
        <span class="divan-corner c-br"></span>

        <span style="font-size: 3rem; color: var(--gold-primary); display: block; margin-bottom: 1rem;">۞</span>
        
        <h1 style="font-family: var(--font-serif); font-size: 2.1rem; color: var(--text-white); margin-bottom: 0.8rem;">
            @L["Notes_AccessDeniedHeading"]
        </h1>

        <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.7; margin-bottom: 2rem;">
            <strong>@User.Identity?.Name</strong> — @L["Notes_AccessDeniedDesc"]
        </p>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn-divan-primary">
                @L["Common_BackHome"]
            </a>
            <a asp-area="" asp-controller="Projects" asp-action="Index" class="btn-ottoman-outline">
                @L["Common_BrowseProjects"]
            </a>
        </div>
    </div>
</div>
