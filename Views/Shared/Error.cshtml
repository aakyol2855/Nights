@model Nights.Models.ErrorViewModel
@{
    ViewData["Title"] = "Bir Hata Oluştu";
}

<div style="max-width: 700px; margin: 3rem auto; text-align: center;">
    <div class="ottoman-frame" style="padding: 3rem 2rem;">
        <span class="ottoman-corner corner-tl"></span>
        <span class="ottoman-corner corner-tr"></span>
        <span class="ottoman-corner corner-bl"></span>
        <span class="ottoman-corner corner-br"></span>

        <span style="font-size: 2.5rem; color: var(--danger-rose); display: block; margin-bottom: 0.5rem;">۞</span>
        <h1 style="font-size: 2rem; color: var(--accent-sapphire); margin-bottom: 0.8rem;">Beklenmeyen Bir Hata Oluştu</h1>
        <p style="color: var(--text-muted); font-size: 1.05rem; line-height: 1.6; margin-bottom: 1.5rem;">
            İsteğiniz işlenirken sunucu tarafında geçici bir aksaklık meydana geldi.
        </p>

        @if (Model?.ShowRequestId == true)
        {
            <div style="background: rgba(20, 34, 54, 0.05); padding: 0.75rem 1.25rem; border-radius: var(--radius-sm); display: inline-block; margin-bottom: 2rem; border: 1px dashed var(--accent-gold);">
                <span style="font-size: 0.88rem; color: var(--text-muted);">İstek Kimliği (Request ID):</span>
                <code style="font-family: monospace; font-weight: bold; color: var(--accent-sapphire); margin-left: 0.4rem;">@Model.RequestId</code>
            </div>
        }

        <div>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn-ottoman">
                <span>✦ Ana Sayfaya Dön</span>
            </a>
        </div>
    </div>
</div>
