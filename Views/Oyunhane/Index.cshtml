@model Nights.Models.ViewModels.OyunhaneIndexViewModel
@{
    ViewData["Title"] = "Oyunhane & Genel Top Tier List";
}

<link rel="stylesheet" href="~/css/games/oyunhane.css" asp-append-version="true" />

<div class="oyunhane-container">
    <!-- Başlık -->
    <div style="text-align: center; margin-bottom: 2.25rem;">
        <span class="badge-ottoman">
            <span>۞</span> MECLİS-İ İRFAN &amp; OYUNHANE <span>۞</span>
        </span>
        <h1 style="font-family: var(--font-serif); font-size: 2.6rem; color: var(--text-white); margin: 0.55rem 0;">
            Oyunhane &amp; Zeka Meydanı
        </h1>
        <p style="color: var(--text-muted); font-size: 1.02rem; max-width: 680px; margin: 0 auto;">
            Tamamı tarayıcınızda sıfır sunucu yüküyle çalışan strateji ve mantık oyunları. Her oyunun ilk 10 listesine girerek kümülatif <strong>Tier Puanı</strong> toplayın ve Genel Sıralamada zirveye yükselin.
        </p>
    </div>

    <div class="ottoman-divider">
        <div class="ottoman-divider-crest">
            <span>✦</span> ۞ <span>✦</span>
        </div>
    </div>

    <div class="oyunhane-layout-grid">
        <!-- SOL: Modüler Oyun Vitrini (IGameModule koleksiyonundan otomatik beslenir) -->
        <section>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.15rem;">
                <h2 style="font-size: 1.55rem; color: var(--text-white); margin: 0;">
                    ✦ Aktif Oyun Modülleri (@Model.Games.Count)
                </h2>
                <span style="font-size: 0.82rem; color: var(--gold-bright);">Tak-Çıkar Modüler Altyapı</span>
            </div>

            <div class="oyunhane-games-grid">
                @foreach (var game in Model.Games)
                {
                    <div class="divan-corner-box oyunhane-game-card">
                        <span class="divan-corner c-tl"></span>
                        <span class="divan-corner c-tr"></span>
                        <span class="divan-corner c-bl"></span>
                        <span class="divan-corner c-br"></span>

                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <div class="oyunhane-game-icon" aria-hidden="true">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                        <line x1="9" y1="3" x2="9" y2="21"></line>
                                        <line x1="15" y1="3" x2="15" y2="21"></line>
                                        <line x1="3" y1="9" x2="21" y2="9"></line>
                                        <line x1="3" y1="15" x2="21" y2="15"></line>
                                    </svg>
                                </div>
                                <span class="badge-ottoman" style="font-size: 0.72rem; padding: 0.2rem 0.65rem;">@game.Category</span>
                            </div>

                            <h3 style="font-size: 1.65rem; color: var(--text-white); margin-bottom: 0.45rem;">@game.Title</h3>
                            <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.55;">@game.Description</p>

                            @if (game.Difficulties.Any())
                            {
                                <div class="oyunhane-diff-tags">
                                    @foreach (var diff in game.Difficulties)
                                    {
                                        <span class="oyunhane-diff-tag" title="Çarpan: @(diff.Multiplier)x">
                                            @diff.Label (@(diff.Multiplier.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))x)
                                        </span>
                                    }
                                </div>
                            }
                        </div>

                        <div style="border-top: 1px solid rgba(197, 160, 89, 0.2); padding-top: 1.15rem; display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 0.78rem; color: var(--text-dim);">Top 10 Grand Prix Puanlı</span>
                            <a asp-controller="Oyunhane" asp-action="Play" asp-route-slug="@game.Slug" class="btn-divan-primary" style="padding: 0.6rem 1.35rem; font-size: 0.85rem;">
                                <span>✦ Oyna &rarr;</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- SAĞ: Kümülatif Genel "Top Tier List" Kenar Paneli -->
        <aside class="divan-corner-box ottoman-frame tier-panel">
            <span class="divan-corner c-tl"></span>
            <span class="divan-corner c-tr"></span>
            <span class="divan-corner c-bl"></span>
            <span class="divan-corner c-br"></span>

            <div class="tier-header">
                <div>
                    <h2 style="font-size: 1.45rem; color: var(--gold-bright); margin: 0;">♛ Genel Top Tier List</h2>
                    <span style="font-size: 0.78rem; color: var(--text-muted);">Tüm Oyunların Kümülatif Şampiyonluk Puanı</span>
                </div>
                <button type="button" id="refreshTopTierBtn" class="btn-ottoman-outline" style="padding: 0.3rem 0.65rem; font-size: 0.75rem;" title="Sıralamayı Yenile">
                    ↻ Yenile
                </button>
            </div>

            <div id="globalTopTierContainer" class="tier-list">
                @if (!Model.GlobalTopTier.Any())
                {
                    <div style="padding: 2rem 1rem; text-align: center; color: var(--text-muted); font-size: 0.9rem;">
                        <span style="font-size: 2rem; color: var(--gold-primary); display: block; margin-bottom: 0.4rem;">۞</span>
                        Henüz sıralamaya giren bir oyuncu bulunmuyor. İlk oyunu tamamlayarak zirvenin ilk sahibi olun!
                    </div>
                }
                else
                {
                    @foreach (var entry in Model.GlobalTopTier)
                    {
                        var topClass = entry.Rank == 1 ? "is-top-1" : entry.Rank == 2 ? "is-top-2" : entry.Rank == 3 ? "is-top-3" : "";
                        var meClass = entry.IsCurrentUser ? "is-current-player" : "";
                        <div class="tier-row @topClass @meClass">
                            <span class="tier-rank-badge">@entry.Rank</span>
                            <div class="tier-player-meta">
                                <div class="tier-player-name">
                                    <span>@entry.PlayerDisplayName</span>
                                    @if (entry.IsGuestSession)
                                    {
                                        <span class="guest-pill">Misafir</span>
                                    }
                                </div>
                                <div class="tier-player-sub">
                                    Ünvan: <strong style="color: var(--gold-bright);">@entry.TierTitle</strong> &bull; @entry.GamesRankedCount Oyun Derecesi
                                </div>
                            </div>
                            <div class="tier-points-box">
                                <div class="tier-points-val">@entry.TotalTierPoints</div>
                                <div class="tier-points-lbl">Tier Puanı</div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Puan Dağıtım Özeti -->
            <div style="margin-top: 1rem; padding-top: 0.85rem; border-top: 1px solid rgba(197, 160, 89, 0.16); font-size: 0.76rem; color: var(--text-dim);">
                <strong>Grand Prix Kuralı:</strong> Her oyunun Top 10 tablosu sırasıyla <code>100, 80, 65, 50, 40, 30, 25, 20, 15, 10</code> baz Tier Puanı × zorluk çarpanı kazandırır.
            </div>

            <!-- Misafir Oturumu Bilgilendirme Notu -->
            <div class="divan-guest-notice">
                <span>۞</span>
                <em>"Misafir oturumunda kazanılan puanlar yalnızca mevcut oturum süresince geçerlidir. Skorlarınızı kalıcı kılmak ve Genel Top Tier List'te yerinizi korumak için
                <a asp-area="Identity" asp-page="/Account/Login" style="font-weight: 600; text-decoration: underline;">giriş yapın</a> veya
                <a asp-area="Identity" asp-page="/Account/Register" style="font-weight: 600; text-decoration: underline;">kayıt olun</a>."</em>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/js/games/oyunhane-hub.js" asp-append-version="true"></script>
}
