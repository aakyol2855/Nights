{
  "DemoOrchestrator": {
    "ContainerCli": "podman",
    "IdleTimeoutMinutes": 15,
    "SharedNetworkName": "divan_demo_net",
    "MemoryLimit": "512m",
    "CpuLimit": "1.0",
    "StartupTimeoutSeconds": 45
  },
  "Maintenance": {
    "TrashRetentionDays": 30,
    "AuditLogRetentionDays": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "AllowedHosts": "*"
}
